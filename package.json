{
  "name": "dsh-semble",
  "version": "2.3.0",
  "type": "module",
  "main": "lib/index.js",
  "description": "Semble 语义代码搜索（semantic code search）MCP bundle：安装即用，无需客户端配置。Semble semantic code search for DeepSeek Harness via MCP (search / find_related).",
  "license": "MIT",
  "author": "Liu Kai",
  "icon": "icon.svg",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "homepage": "https://github.com/CodeIntegrity/dsh-semble#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeIntegrity/dsh-semble.git"
  },
  "bugs": {
    "url": "https://github.com/CodeIntegrity/dsh-semble/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "semble",
    "mcp",
    "code-search",
    "semantic-search"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
